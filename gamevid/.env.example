# Copy to .env (start.bat does this for you). No key is required to run.

# --- LLM (script stage; added in build step 2) ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Captions ---
# local = faster-whisper on your CPU (free). api = OpenAI Whisper API (needs OPENAI_API_KEY).
WHISPER_MODE=local
# tiny | base | small | medium  (small is a good CPU default)
WHISPER_MODEL=small
OPENAI_API_KEY=

# --- ffmpeg (leave blank if ffmpeg is on PATH) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- Cleanup ---
# Finished renders kept per project; older ones are deleted after each render.
KEEP_RENDERS=2

PORT=8000
